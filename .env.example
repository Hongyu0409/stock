# LINE Messaging API 設定 (可填寫長效 Token，或填寫 Channel ID + Secret 自動換發 Token)
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# 選填：指定接收推播的 User ID (U開頭) 或群組 ID (C開頭)，多個可用逗號分隔。
# 若留空，系統會自動透過 Broadcast API 推播給所有加入此 LINE 官方帳號的好友！
LINE_USER_ID=

# 選填：推播訊息模式 ("both" 同時推播精美輪播卡片與文字戰報 / "flex" 僅卡片 / "text" 僅文字)
LINE_MESSAGE_MODE=both

# Telegram Bot 推播設定 (選填，填入後將同時推播至 Telegram)
TELEGRAM_BOT_TOKEN=9167449372:AAFDgg4hmT_Hm4RrpFo1lYIqZesJaxkVpfI
# 選填：指定接收推播的 Telegram Chat ID。若留空，系統會自動向 Bot 搜尋最新的對話！
TELEGRAM_CHAT_ID=
