# LINE Messaging API 設定 (必填：Channel Access Token)
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here

# 選填：指定接收推播的 User ID (U開頭) 或群組 ID (C開頭)，多個可用逗號分隔。
# 若留空，系統會自動透過 Broadcast API 推播給所有加入此 LINE 官方帳號的好友！
LINE_USER_ID=

# 選填：推播訊息模式 ("both" 同時推播精美輪播卡片與文字戰報 / "flex" 僅卡片 / "text" 僅文字)
LINE_MESSAGE_MODE=both
